rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ['imadu.mcraze@gmail.com'];
    }

    function isTeamMember() {
      return request.auth != null && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid)) && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.active == true;
    }

    match /clients/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTeamMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'actualPublishedDate', 'postUrl', 'remarks', 'updatedAt', 'completedAt', 'completedById']));
    }

    match /contentNotes/{noteId} {
      allow read: if true;
      allow create: if (isAdmin() || isTeamMember())
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update: if (isAdmin() || (isTeamMember() && resource.data.authorId == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','updatedAt','edited','editedByName'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow delete: if isAdmin() || (isTeamMember() && resource.data.authorId == request.auth.uid);
    }

    match /teamTasks/{id} {
      allow read: if isAdmin() || (isTeamMember() && resource.data.assignedToId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTeamMember() && resource.data.assignedToId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','doneAt','updatedAt']));
    }

    match /teamMembers/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /adminSettings/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
